# =================================================================
# PROGRAMA DE GESTIÓN DE CALIFICACIONES - SEMANA 13
# Objetivo: Registrar alumnos y promedios manejando errores de entrada.
# =================================================================

def iniciar_programa():
    # Bloque: Estructura de datos
    # Diccionario para almacenar nombres como llaves y listas de notas como valores
    registro_alumnos = {}

    # Bloque: Ciclo de Vida del Programa
    # Mantiene el menú activo hasta que el usuario decida salir (Opción S)
    while True:
        print("\n--- SISTEMA DE GESTIÓN ESCOLAR ---")
        print("1. Agregar un nuevo alumno")
        print("2. Ver los alumnos y las calificaciones")
        print("S. Salir")
        
        opcion = input("Selecciona una opción: ").strip().upper()

        # Bloque: Lógica para Agregar Alumnos (Opción 1)
        if opcion == '1':
            # Validación de nombre: No permite strings vacíos
            nombre = input("Nombre completo del alumno: ").strip()
            while not nombre:
                print("¡Error! El nombre es obligatorio para el registro.")
                nombre = input("Nombre completo del alumno: ").strip()

            # Bloque: Captura de cantidad de notas con manejo de excepciones
            try:
                cantidad = int(input(f"¿Cuántas calificaciones registrarás para {nombre}?: "))
                lista_notas = []
                
                # Bloque: Ciclo de captura de calificaciones individuales
                # Si el usuario ingresa texto, el programa pide el dato de nuevo sin cerrarse
                contador = 0
                while contador < cantidad:
                    try:
                        calif = float(input(f"Ingresa la nota #{contador + 1}: "))
                        lista_notas.append(calif)
                        contador += 1
                    except ValueError:
                        print("Entrada inválida. Por favor, usa números para las calificaciones.")
                
                registro_alumnos[nombre] = lista_notas
                print(f"✔ Datos de {nombre} guardados correctamente.")

            except ValueError:
                print("Error: Debes ingresar un número entero para la cantidad de notas.")

        # Bloque: Lógica para Mostrar Reportes (Opción 2)
        elif opcion == '2':
            if not registro_alumnos:
                print("No hay datos registrados en el sistema.")
            else:
                print("\n--- LISTADO DE PROMEDIOS ---")
                for alumno, notas in registro_alumnos.items():
                    # Cálculo del promedio: suma de elementos entre cantidad de elementos
                    promedio = sum(notas) / len(notas)
                    print(f"{alumno}: Promedio {promedio:.2f}")

        # Bloque: Lógica de Salida (Opción S)
        elif opcion == 'S':
            confirmacion = input("¿Estás seguro de que deseas cerrar el programa? (S/N): ").upper()
            if confirmacion == 'S':
                print("Cerrando sistema... ¡Buen día!")
                break
        
        # Bloque: Manejo de opciones de menú incorrectas
        else:
            print("Opción no válida. Intenta con 1, 2 o S.")

# Bloque: Ejecución principal
if __name__ == "__main__":
    iniciar_programa()